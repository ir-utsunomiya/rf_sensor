    def sample(self):
        if len(self.data) > 0:
            z = np.zeros(self.nap)
            mac_rss_values = {}

            for datum in self.data:
                try:
                    index = self.mac_dict[datum.mac_address]
                    if datum.mac_address not in mac_rss_values:
                        mac_rss_values[datum.mac_address] = []

                    # アンテナごとのRSS値をリストに追加
                    mac_rss_values[datum.mac_address].extend(datum.data)
                except KeyError:
                    rospy.logwarn("Address not found in the dict: {}".format(datum.mac_address))
            
            self.data = list()  # バッファをクリア

            # ベクトルの初期化
            vec = Float32MultiArray()

            for mac, rss_list in mac_rss_values.items():
                index = self.mac_dict[mac]

                # RSS値をソートして大きい3つを取得
                top_rss_values = sorted(rss_list, reverse=True)[:3]
                
                # 平均値を計算
                avg_rss = np.mean(top_rss_values)

                # mWに変換
                mW = 10**(avg_rss / 10)
                
                # ログに出力
                rospy.loginfo("MAC Address: {}, Index: {}, Top 3 RSS Avg: {:.2f}, mW: {:.2f}".format(
                    mac, index, avg_rss, mW))
                
                # ベクトルに追加
                z[index] = mW

            # 配信データの設定
            vec.data = np.array(z, dtype=float).tolist()

            # メッセージの配信
            self.pub_vec.publish(vec)
        else:
            rospy.loginfo('Not enough samples')
        return 0


    def run(self):
        while not rospy.is_shutdown():
            self.sample()
            self.rate.sleep()

